<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>marvin.host</groupId>
    <artifactId>marvin-host-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>marvin-adapter-web</artifactId>
  <name>Marvin web adapter</name>
  <description>Inbound: the app (static files), its REST API and Server-Sent Events, on Spring MVC</description>

  <dependencies>
    <dependency>
      <groupId>marvin.host</groupId>
      <artifactId>marvin-application</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>marvin.host</groupId>
      <artifactId>marvin-contracts</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- memory's in-memory stores, for the memory API's tests without a database -->
      <groupId>marvin.host</groupId>
      <artifactId>marvin-application</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
